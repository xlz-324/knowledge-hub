{
  "name": "knowledge-hub",
  "version": "0.0.0",
  "private": true,
  "description": "Personal knowledge hub with web clipping, Markdown notes, search and RAG Q&A.",
  "scripts": {
    "dev": "pnpm --parallel --filter @knowledge-hub/web --filter @knowledge-hub/api dev",
    "dev:web": "pnpm --filter @knowledge-hub/web dev",
    "dev:api": "pnpm --filter @knowledge-hub/api dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "test:e2e": "pnpm --filter @knowledge-hub/api test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.10.0",
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
